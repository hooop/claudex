Output docs/demo/claudex.gif

Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 26
Set LineHeight 1.1
Set Width 1320
Set Height 1752
Set Padding 32
Set BorderRadius 40
Set MarginFill ""
Set Framerate 30
Set TypingSpeed 22ms
Set Theme {
  "name": "claudex",
  "black": "#171717",
  "red": "#ef3240",
  "green": "#5dd7c3",
  "yellow": "#f5c542",
  "blue": "#2b55f7",
  "magenta": "#fdbabf",
  "cyan": "#9ae6ff",
  "white": "#eeeeee",
  "brightBlack": "#555555",
  "brightRed": "#ef3240",
  "brightGreen": "#5dd7c3",
  "brightYellow": "#f5c542",
  "brightBlue": "#2b55f7",
  "brightMagenta": "#fdbabf",
  "brightCyan": "#d6fbff",
  "brightWhite": "#ffffff",
  "background": "#171717",
  "foreground": "#eeeeee",
  "selection": "#3a3a3a",
  "cursor": "#eeeeee"
}

Hide
Type "node --import tsx docs/demo/claudex-session.tsx"
Enter
Sleep 600ms
Show
Sleep 2500ms
Sleep 500ms
Type "Comment refondre l'auth sans couper les utilisateurs connectés ?"
Sleep 500ms
Enter
Sleep 4400ms
Screenshot docs/demo/claudex.png
Sleep 2s
