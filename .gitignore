node_modules/
dist/
*.log
*.heapsnapshot
.DS_Store

# Memory written by Claudex during debates run on this repository. Same policy
# as the .claudex/.gitignore it writes in its users' projects (CLAUDEX_GITIGNORE
# in src/memory/store.ts): everything is excluded by default, including files
# later versions add, and only decisions.md and limits.md are versioned, because
# they are short, written on purpose, and read by both agents at the start of
# every debate.
.claudex/*
!.claudex/memory/
.claudex/memory/*
!.claudex/memory/decisions.md
!.claudex/memory/limits.md

# Raw debate exports, kept locally.
debat.md/

# Claude Code configuration: what is written on purpose and helps anyone who
# clones the repository is versioned (the subagents), what is specific to one
# machine is not.
.claude/settings.local.json
